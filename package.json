{
  "name": "physics-lab",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:changed": "vitest run --changed",
    "test:e2e": "playwright test",
    "test:physics": "vitest run && node scripts/validate-physics.mjs",
    "validate:boiler": "node scripts/check-boiler.mjs",
    "validate:coupled": "node scripts/check-coupled.mjs",
    "validate:physics": "node scripts/validate-physics.mjs",
    "validate:spatial": "node scripts/check-spatial.mjs",
    "validate:scaling": "node scripts/validate-scaling.mjs",
    "audit:parameters": "node scripts/parameter-audit.mjs",
    "benchmark:spatial": "node scripts/benchmark-spatial.mjs",
    "validate:examples": "node scripts/check-examples.mjs",
    "validate:presets": "node scripts/check-presets.mjs",
    "check": "scripts/check.sh",
    "check:quick": "tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc.tsbuildinfo -p . && vitest run --changed",
    "check:fast": "scripts/check.sh --no-e2e",
    "check:scores": "node scripts/check-scores.mjs",
    "test:e2e:prod": "scripts/e2e.sh",
    "test:e2e:quick": "scripts/e2e.sh --grep-invert @slow",
    "deploy": "scripts/deploy.sh",
    "tokens": "UPDATE_TOKENS=1 vitest run src/theme/tokens.test.ts"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "planck": "1.4.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "esbuild": "0.25.12",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^5.0.3"
  }
}
